#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
demo_bin="/tmp/stash-demo-bin"

cleanup() {
	rm -rf "$repo/demo/.bin" "$repo/demo/home/Library" "$repo/demo/home/go" "$demo_bin"
	rm -f "$repo/demo/home/.stash/session-cache.json" "$repo/demo/home/.stash/codex-cache.json"
}
trap cleanup EXIT
cleanup

mkdir -p "$demo_bin"

GOCACHE="${TMPDIR:-/tmp}/stash-demo-gocache" \
	GOMODCACHE="${TMPDIR:-/tmp}/stash-demo-modcache" \
	GOPATH="${TMPDIR:-/tmp}/stash-demo-gopath" \
	GOTELEMETRY=off \
	go build -o "$demo_bin/stash" "$repo/cmd/stash"

cat >"$demo_bin/claude" <<'SH'
#!/usr/bin/env bash
echo "Demo: would resume Claude session ${*: -1}"
SH
cat >"$demo_bin/codex" <<'SH'
#!/usr/bin/env bash
if [[ "${1:-}" == "resume" ]]; then
  echo "Demo: would resume Codex session ${2:-}"
else
  echo "Demo codex shim"
fi
SH
chmod +x "$demo_bin/claude" "$demo_bin/codex"

cd "$repo"
HOME="$repo/demo/home" PATH="$demo_bin:$PATH" TERM=xterm-256color COLORTERM=truecolor FORCE_COLOR=1 CLICOLOR_FORCE=1 STASH_NO_ALT_SCREEN=1 STASH_FORCE_STDIN=1 STASH_FORCE_COLOR=1 vhs demo/stash.tape
