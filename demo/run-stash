#!/usr/bin/env bash
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
bin="$repo/demo/.bin/stash"

mkdir -p "$(dirname "$bin")"
GOCACHE="${TMPDIR:-/tmp}/stash-demo-gocache" \
	GOMODCACHE="${TMPDIR:-/tmp}/stash-demo-modcache" \
	GOPATH="${TMPDIR:-/tmp}/stash-demo-gopath" \
	GOTELEMETRY=off \
	go build -o "$bin" "$repo/cmd/stash"

HOME="$repo/demo/home" exec "$bin" "$@"
